Header { Title "Public synthetic STPG runner fixture"; }
Signals {
  D0 InOut;
  D1 InOut;
}
SignalGroups {
  ALL = 'D0 + D1';
}
Timing {
  WaveformTable NORMAL {
    Period '400ns';
    Waveforms {
      ALL { 0: 0ns Drive(0); 1: 0ns Drive(1); X: 100ns Compare(X); }
    }
  }
}
Pattern MAIN {
  W NORMAL;
  V { ALL = 01; }
  V { ALL = 1X; }
  V { ALL = 10; }
  V { ALL = 0X; }
}
