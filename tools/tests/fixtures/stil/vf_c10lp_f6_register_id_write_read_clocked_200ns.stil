      io_3 { 0: 0ns Drive(0); 1: 0ns Drive(1); }
      io_4 { 0: 0ns Drive(0); 1: 0ns Drive(1); }
      dout_6 { H: 100ns Compare(1); L: 100ns Compare(0); T: 100ns Compare(X); }
