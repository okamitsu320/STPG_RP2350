Header { Title "vf_c10lp F3 mode-2 counter plus mode-3 short LFSR"; }
Signals {
  clk InOut;
  rst_n InOut;
  mode_0 InOut;
  mode_1 InOut;
  mode_2 InOut;
  mode_3 InOut;
  ctrl_0 InOut;
  ctrl_1 InOut;
  ctrl_2 InOut;
  io_0 InOut;
  io_1 InOut;
  io_2 InOut;
  io_3 InOut;
  io_4 InOut;
