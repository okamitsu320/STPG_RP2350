Header { Title "c1-macro-m5-sampled-200ns"; }
Signals {
  D0 InOut;
  D1 InOut;
}
SignalGroups {
  ALL = 'D0 + D1';
}
Timing {
  WaveformTable WFT1 {
    Period '200ns';
    Waveforms {
      D0 { 0: 0ns Drive(0); 1: 0ns Drive(1); }
      D1 { X: 0ns Compare(X); }
    }
  }
}
PatternBurst PB1 {
  PatList {
    MAIN;
  }
}
Pattern MAIN {
  W WFT1;
  V { ALL = 0X; }
  V { ALL = 1X; }
}
