Header { Title "c1-macro-m3-200ns"; }
Signals {
  D0 InOut;
  D1 InOut;
}
SignalGroups {
  ALL = 'D0 + D1';
}
Timing {
  WaveformTable WFT1 {
    Period '200ns';
    Waveforms {
      ALL { 0: 0ns Drive(0); 1: 0ns Drive(1); }
    }
  }
}
PatternBurst PB1 {
  PatList {
    MAIN;
  }
}
Pattern MAIN {
  W WFT1;
  V { ALL = 01; }
  V { ALL = 10; }
}
